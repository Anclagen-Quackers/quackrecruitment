RewriteEngine on

# Specific legacy programme redirects first
RewriteRule ^training/wmca-retrofit/?$ /skills-bootcamps/retrofit/wmca/ [NC,R=301,L]
RewriteRule ^training/retrofit/wmca/?$ /skills-bootcamps/retrofit/wmca/ [NC,R=301,L]
RewriteRule ^training/retrofit/enterprise-cheshire-warrington/?$ /skills-bootcamps/retrofit/enterprise-cheshire-warrington/ [NC,R=301,L]
RewriteRule ^training/construction-utilities-hcc/?$ /skills-bootcamps/construction-utilities/hcc/ [NC,R=301,L]

# Retired sections
RewriteRule ^training(?:/.*)?$ /skills-bootcamps/ [NC,R=301,L]
RewriteRule ^multiply(?:/.*)?$ /skills-bootcamps/ [NC,R=301,L]

# Existing frontend fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html?path=$1 [NC,L,QSA]